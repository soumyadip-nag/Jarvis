# Copy this file to ".env" and fill in your own keys. Never commit .env.
Username=Your Name
Assistantname=Jarvis
Honorific=sir

# Cloud sync with the phone app (optional). When set, the laptop uses the shared cloud brain.
# JARVIS_SERVER_URL=https://your-jarvis-site.netlify.app
# JARVIS_PASSCODE=

GROQ_API_KEY=

# Image generation (free): the Cloudflare token needs the "Workers AI" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional fallback if Cloudflare fails. Pollinations (no key) is always the last resort.
HuggingFaceAPIKey=

# Optional overrides (change these when a provider retires a model)
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_CONTENT_MODEL=openai/gpt-oss-120b
# GROQ_ROUTER_MODEL=openai/gpt-oss-20b
# IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Voice (edge-tts). Other British options: en-GB-ThomasNeural, en-GB-OliverNeural
# AssistantVoice=en-GB-RyanNeural
# VOICE_RATE=-4%
# VOICE_PITCH=-2Hz
# VOICE_FX=true
# MAX_HISTORY_MESSAGES=20
